    // 5. التحقق من حالة العملية بعد كل خطوة
    let status = OrchestratorContract::get_process_status(env.clone(), policy_id);
    assert_eq!(status, Symbol::new(&env, "S_REQ")); // PROCESS_STATUS_SERVICE_REQUESTED

